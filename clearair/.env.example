# Copy to .env. Never commit the real .env.

# AirNow key, needed once air quality is added. Request one at https://docs.airnowapi.org/
AIRNOW_API_KEY=

# Port for the API server.
PORT=3001

# NWS asks apps to identify themselves. Optional; defaults to the repo URL.
# NWS_USER_AGENT=ClearAir (you@example.com)
